{
  "name": "sancho",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch src/server.ts",
    "build": "vue-tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server.js",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "db:migrate": "tsx src/migrate.ts",
    "admin:create": "node dist-server/admin.js",
    "test": "vitest run --config vitest.config.ts",
    "simulator:seed": "node dist-server/simulator.js",
    "test:integration": "vitest run --config vitest.config.ts tests/flow.integration.test.ts",
    "backup": "sh scripts/backup.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.301",
    "@fontsource-variable/dm-sans": "5.3.0",
    "bcryptjs": "2.4.3",
    "connect-pg-simple": "10.0.0",
    "cors": "2.8.5",
    "dompurify": "3.4.17",
    "dotenv": "^16.4.7",
    "express": "4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "7.5.0",
    "express-session": "1.19.0",
    "helmet": "8.0.0",
    "lucide-vue-next": "1.0.0",
    "marked": "18.1.1",
    "pg": "8.13.1",
    "vue": "3.5.44",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cors": "2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "1.18.1",
    "@types/node": "^22.20.5",
    "@types/pg": "8.11.10",
    "@vitejs/plugin-vue": "^6.0.10",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "2.2.0"
  }
}
