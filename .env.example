POSTGRES_DB=sancho
POSTGRES_USER=sancho
POSTGRES_PASSWORD=replace-with-url-safe-random-password
SESSION_SECRET=replace-with-random-session-secret
# Desarrollo local por HTTP. En producción, usa true detrás de Caddy/HTTPS.
SESSION_COOKIE_SECURE=false
# Base64 de 32 bytes aleatorios: openssl rand -base64 32
SANCHO_ENCRYPTION_KEY=replace-with-32-byte-base64-key
SANCHO_PORT=3000
PUBLIC_BASE_URL=https://sancho.example.org
CADDY_DOMAIN=sancho.example.org
# Límite de salida por llamada a OpenAI. En modelos con razonamiento incluye los tokens de razonamiento.
OPENAI_MAX_OUTPUT_TOKENS=16000
# Días que se guarda lo enviado a OpenAI y su respuesta (consulta: node dist-server/ai-log.js). 0 = no se guarda.
AI_EXCHANGE_RETENTION_DAYS=30
# Motor de agente (servicio cerebro). Token interno entre worker y cerebro: openssl rand -hex 32
CEREBRO_TOKEN=replace-with-random-internal-token
# Carpeta con la sesión de Claude Code del servidor (suscripción). Vacía en local si no la usas.
CLAUDE_DIR=/home/usuario/.claude
# Opcional: con una clave de Anthropic, el agente factura por consumo en vez de usar la suscripción.
ANTHROPIC_API_KEY=
